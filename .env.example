# ==============================================================================
# AgriSahayak - Environment Configuration Template
# Copy this file to .env or server/.env and fill in your credentials
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Google Gemini AI API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Supabase Cloud PostgreSQL Configuration
# Found in Supabase Dashboard -> Project Settings -> API & Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Supabase Direct PostgreSQL Connection (Used by migration runner & direct pooling)
# Found in Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Weather API Configuration (Optional)
# AgriSahayak has a built-in Open-Meteo integration that works automatically WITHOUT any API key!
# If you prefer OpenWeatherMap, provide your API key below:
OPENWEATHER_API_KEY=
